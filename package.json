{
  "name": "canvas-coordinator",
  "productName": "Campus Coordinator",
  "version": "0.2.0",
  "description": "A local workspace for university course coordination and email templates",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:electron": "node tests/electron-smoke.mjs",
    "pack:mac": "electron-builder --mac --dir --publish never",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  }
}
